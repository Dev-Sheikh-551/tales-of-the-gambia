[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 1.96,
    "text": "Imagine the work.",
    "charStart": 0,
    "charEnd": 17
  },
  {
    "index": 1,
    "startSeconds": 1.96,
    "endSeconds": 8.57,
    "text": "Laterite — the deep red iron-rich rock that underlies much of the Gambia River basin — is hard.",
    "charStart": 19,
    "charEnd": 114
  },
  {
    "index": 2,
    "startSeconds": 8.57,
    "endSeconds": 21.18,
    "text": "Not impossibly hard, but the kind of hard that demands time and attention and the steady, unremarkable courage of people who know that large things are built slowly.",
    "charStart": 115,
    "charEnd": 280
  },
  {
    "index": 3,
    "startSeconds": 21.18,
    "endSeconds": 25.49,
    "text": "The stonecutters found outcrops of laterite on the plateau.",
    "charStart": 282,
    "charEnd": 341
  },
  {
    "index": 4,
    "startSeconds": 25.49,
    "endSeconds": 39.01,
    "text": "They quarried the stone — using iron tools, fire, and wedges — into cylinders, some of them over two metres tall, some shorter, all of them shaped to stand upright in the earth without falling.",
    "charStart": 342,
    "charEnd": 535
  },
  {
    "index": 5,
    "startSeconds": 39.01,
    "endSeconds": 41.51,
    "text": "Each cylinder had to be moved.",
    "charStart": 537,
    "charEnd": 567
  },
  {
    "index": 6,
    "startSeconds": 41.51,
    "endSeconds": 42.5,
    "text": "Dragged.",
    "charStart": 568,
    "charEnd": 576
  },
  {
    "index": 7,
    "startSeconds": 42.5,
    "endSeconds": 43.52,
    "text": "Raised.",
    "charStart": 577,
    "charEnd": 584
  },
  {
    "index": 8,
    "startSeconds": 43.52,
    "endSeconds": 48.03,
    "text": "Planted in a circle, at regular intervals, around a burial mound.",
    "charStart": 585,
    "charEnd": 650
  },
  {
    "index": 9,
    "startSeconds": 48.03,
    "endSeconds": 50.68,
    "text": "We do not know exactly how they did it.",
    "charStart": 652,
    "charEnd": 691
  },
  {
    "index": 10,
    "startSeconds": 50.68,
    "endSeconds": 51.97,
    "text": "We know they did it.",
    "charStart": 692,
    "charEnd": 712
  },
  {
    "index": 11,
    "startSeconds": 51.97,
    "endSeconds": 54.53,
    "text": "More than 1,000 times.",
    "charStart": 713,
    "charEnd": 735
  },
  {
    "index": 12,
    "startSeconds": 54.53,
    "endSeconds": 57.56,
    "text": "The effort is staggering to contemplate.",
    "charStart": 737,
    "charEnd": 777
  },
  {
    "index": 13,
    "startSeconds": 57.56,
    "endSeconds": 63.08,
    "text": "Not because it is exotic or primitive — but because it is profoundly recognisable.",
    "charStart": 778,
    "charEnd": 860
  },
  {
    "index": 14,
    "startSeconds": 63.08,
    "endSeconds": 69.97,
    "text": "This is what communities do when someone they love dies and they want the world to know that this person existed.",
    "charStart": 861,
    "charEnd": 974
  },
  {
    "index": 15,
    "startSeconds": 69.97,
    "endSeconds": 73.58,
    "text": "They mark the place.",
    "charStart": 975,
    "charEnd": 995
  },
  {
    "index": 16,
    "startSeconds": 73.58,
    "endSeconds": 78.32,
    "text": "They make it hard to forget.",
    "charStart": 996,
    "charEnd": 1024
  },
  {
    "index": 17,
    "startSeconds": 78.32,
    "endSeconds": 79.17,
    "text": "Every one of the 1,000-plus stone circles is someone's way of saying: here.",
    "charStart": 1026,
    "charEnd": 1101
  },
  {
    "index": 18,
    "startSeconds": 79.17,
    "endSeconds": 81.25,
    "text": "This person was here.",
    "charStart": 1102,
    "charEnd": 1123
  }
]