[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 4.24,
    "text": "The Mandinka say: A taa ko kelen te kelen ye.",
    "charStart": 0,
    "charEnd": 45
  },
  {
    "index": 1,
    "startSeconds": 4.24,
    "endSeconds": 7.92,
    "text": "What is spoken once is not spoken only once.",
    "charStart": 46,
    "charEnd": 90
  },
  {
    "index": 2,
    "startSeconds": 7.92,
    "endSeconds": 12.18,
    "text": "Kelefa Saane has been spoken ten thousand times.",
    "charStart": 92,
    "charEnd": 140
  },
  {
    "index": 3,
    "startSeconds": 12.18,
    "endSeconds": 14.54,
    "text": "In Banjul and Ziguinchor.",
    "charStart": 141,
    "charEnd": 166
  },
  {
    "index": 4,
    "startSeconds": 14.54,
    "endSeconds": 16.47,
    "text": "In London and Dakar.",
    "charStart": 167,
    "charEnd": 187
  },
  {
    "index": 5,
    "startSeconds": 16.47,
    "endSeconds": 19.17,
    "text": "On stages and by firesides.",
    "charStart": 188,
    "charEnd": 215
  },
  {
    "index": 6,
    "startSeconds": 19.17,
    "endSeconds": 28.66,
    "text": "On recordings and in living rooms where someone plays a kora for the first time and feels, without knowing why, that something important is happening.",
    "charStart": 216,
    "charEnd": 366
  },
  {
    "index": 7,
    "startSeconds": 28.66,
    "endSeconds": 31.15,
    "text": "His story is not complete.",
    "charStart": 368,
    "charEnd": 394
  },
  {
    "index": 8,
    "startSeconds": 31.15,
    "endSeconds": 34.95,
    "text": "It is not complete because the griots are still singing it.",
    "charStart": 396,
    "charEnd": 455
  },
  {
    "index": 9,
    "startSeconds": 34.95,
    "endSeconds": 37.53,
    "text": "Because scholars are still studying it.",
    "charStart": 456,
    "charEnd": 495
  },
  {
    "index": 10,
    "startSeconds": 37.53,
    "endSeconds": 51.57,
    "text": "Because children in the Gambia still hear his name and know — the way you know certain things in your bones before you understand them in your mind — that this was someone who mattered.",
    "charStart": 496,
    "charEnd": 681
  },
  {
    "index": 11,
    "startSeconds": 51.57,
    "endSeconds": 54.25,
    "text": "The Kaabu Empire is history.",
    "charStart": 683,
    "charEnd": 711
  },
  {
    "index": 12,
    "startSeconds": 54.25,
    "endSeconds": 55.61,
    "text": "Kelefa Saane is memory.",
    "charStart": 713,
    "charEnd": 736
  },
  {
    "index": 13,
    "startSeconds": 55.61,
    "endSeconds": 63.47,
    "text": "And memory, as any jali will tell you, is the thing that time cannot touch.",
    "charStart": 738,
    "charEnd": 813
  },
  {
    "index": 14,
    "startSeconds": 63.47,
    "endSeconds": 64.18,
    "text": "I ko Kelefa.",
    "charStart": 815,
    "charEnd": 827
  },
  {
    "index": 15,
    "startSeconds": 64.18,
    "endSeconds": 64.88,
    "text": "They say Kelefa.",
    "charStart": 828,
    "charEnd": 844
  },
  {
    "index": 16,
    "startSeconds": 64.88,
    "endSeconds": 65.55,
    "text": "They always will.",
    "charStart": 846,
    "charEnd": 863
  }
]