[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 4.05,
    "text": "Before there were written pages, there was the kora.",
    "charStart": 0,
    "charEnd": 52
  },
  {
    "index": 1,
    "startSeconds": 4.05,
    "endSeconds": 17.29,
    "text": "And before the kora, there was the voice of the griot — the jali — the keeper of every name, every lineage, every act of courage or cowardice that a kingdom had ever produced.",
    "charStart": 54,
    "charEnd": 229
  },
  {
    "index": 2,
    "startSeconds": 17.29,
    "endSeconds": 21.32,
    "text": "It is the griot who kept Kelefa Saane alive.",
    "charStart": 231,
    "charEnd": 275
  },
  {
    "index": 3,
    "startSeconds": 21.32,
    "endSeconds": 23.05,
    "text": "Not in a book.",
    "charStart": 277,
    "charEnd": 291
  },
  {
    "index": 4,
    "startSeconds": 23.05,
    "endSeconds": 24.61,
    "text": "Not in a monument.",
    "charStart": 292,
    "charEnd": 310
  },
  {
    "index": 5,
    "startSeconds": 24.61,
    "endSeconds": 38.68,
    "text": "But in the curve of twenty-one strings, in the vibration of a gourd resonator, in the memory of a family that has been singing this name — Kelefa, Kelefa, Kelefa — for generations.",
    "charStart": 311,
    "charEnd": 491
  },
  {
    "index": 6,
    "startSeconds": 38.68,
    "endSeconds": 45.95,
    "text": "The Kaabu Empire once stretched across what is now The Gambia, Guinea-Bissau, and Casamance.",
    "charStart": 493,
    "charEnd": 585
  },
  {
    "index": 7,
    "startSeconds": 45.95,
    "endSeconds": 54.95,
    "text": "It was a Mandinka state of great power, a successor to the glory of the Mali Empire.",
    "charStart": 586,
    "charEnd": 670
  },
  {
    "index": 8,
    "startSeconds": 54.95,
    "endSeconds": 57.02,
    "text": "Its warriors were celebrated.",
    "charStart": 671,
    "charEnd": 700
  },
  {
    "index": 9,
    "startSeconds": 57.02,
    "endSeconds": 60.24,
    "text": "Its griots were feared.",
    "charStart": 701,
    "charEnd": 724
  },
  {
    "index": 10,
    "startSeconds": 60.24,
    "endSeconds": 63.72,
    "text": "And its princes were expected to die well.",
    "charStart": 725,
    "charEnd": 767
  },
  {
    "index": 11,
    "startSeconds": 63.72,
    "endSeconds": 65.6,
    "text": "Kelefa Saane was one such prince.",
    "charStart": 769,
    "charEnd": 802
  },
  {
    "index": 12,
    "startSeconds": 65.6,
    "endSeconds": 68.0,
    "text": "This is his story, as best as it can be told.",
    "charStart": 804,
    "charEnd": 849
  }
]