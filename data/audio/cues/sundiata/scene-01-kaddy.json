[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 1.99,
    "text": "My name is Djeli.",
    "charStart": 0,
    "charEnd": 17
  },
  {
    "index": 1,
    "startSeconds": 1.99,
    "endSeconds": 3.88,
    "text": "I am a griot.",
    "charStart": 19,
    "charEnd": 32
  },
  {
    "index": 2,
    "startSeconds": 3.88,
    "endSeconds": 17.46,
    "text": "My father was a griot before me, and his father before him, and before him, and before him — all the way back to the time when the first words were spoken over the first fire, and someone had to remember them.",
    "charStart": 33,
    "charEnd": 242
  },
  {
    "index": 3,
    "startSeconds": 17.46,
    "endSeconds": 20.89,
    "text": "I am here to tell you about Sundiata Keita.",
    "charStart": 244,
    "charEnd": 287
  },
  {
    "index": 4,
    "startSeconds": 20.89,
    "endSeconds": 24.88,
    "text": "You may have heard his name.",
    "charStart": 289,
    "charEnd": 317
  },
  {
    "index": 5,
    "startSeconds": 24.88,
    "endSeconds": 26.62,
    "text": "Sogolon's child.",
    "charStart": 318,
    "charEnd": 334
  },
  {
    "index": 6,
    "startSeconds": 26.62,
    "endSeconds": 30.4,
    "text": "The Lion of Mali.",
    "charStart": 335,
    "charEnd": 352
  },
  {
    "index": 7,
    "startSeconds": 30.4,
    "endSeconds": 35.79,
    "text": "The king who could not walk until the day he decided to stand up — and when he stood, the world shook.",
    "charStart": 353,
    "charEnd": 455
  },
  {
    "index": 8,
    "startSeconds": 35.79,
    "endSeconds": 40.66,
    "text": "This story is 800 years old.",
    "charStart": 457,
    "charEnd": 485
  },
  {
    "index": 9,
    "startSeconds": 40.66,
    "endSeconds": 42.81,
    "text": "But I tell it as if it happened this morning, because that is what griots do.",
    "charStart": 487,
    "charEnd": 564
  },
  {
    "index": 10,
    "startSeconds": 42.81,
    "endSeconds": 44.18,
    "text": "Time is not a line for us.",
    "charStart": 565,
    "charEnd": 591
  },
  {
    "index": 11,
    "startSeconds": 44.18,
    "endSeconds": 47.12,
    "text": "It is a circle.",
    "charStart": 592,
    "charEnd": 607
  },
  {
    "index": 12,
    "startSeconds": 47.12,
    "endSeconds": 52.53,
    "text": "And every time the Sunjata epic is sung, Sundiata lives again — walks again — wins again.",
    "charStart": 608,
    "charEnd": 697
  },
  {
    "index": 13,
    "startSeconds": 52.53,
    "endSeconds": 55.06,
    "text": "So.",
    "charStart": 699,
    "charEnd": 702
  },
  {
    "index": 14,
    "startSeconds": 55.06,
    "endSeconds": 57.52,
    "text": "Let us begin at the beginning.",
    "charStart": 704,
    "charEnd": 734
  },
  {
    "index": 15,
    "startSeconds": 57.52,
    "endSeconds": 62.05,
    "text": "At the royal court of Niani, in the kingdom of the Mandinka, a king received a prophecy.",
    "charStart": 736,
    "charEnd": 824
  }
]