[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.61,
    "text": "The king of Niani had many sons.",
    "charStart": 0,
    "charEnd": 32
  },
  {
    "index": 1,
    "startSeconds": 2.61,
    "endSeconds": 7.82,
    "text": "But one, born of a woman named Sogolon Condé, could not walk.",
    "charStart": 33,
    "charEnd": 94
  },
  {
    "index": 2,
    "startSeconds": 7.82,
    "endSeconds": 10.15,
    "text": "His name was Sundiata.",
    "charStart": 96,
    "charEnd": 118
  },
  {
    "index": 3,
    "startSeconds": 10.15,
    "endSeconds": 11.67,
    "text": "He crawled.",
    "charStart": 120,
    "charEnd": 131
  },
  {
    "index": 4,
    "startSeconds": 11.67,
    "endSeconds": 14.59,
    "text": "He dragged himself across the palace floors.",
    "charStart": 132,
    "charEnd": 176
  },
  {
    "index": 5,
    "startSeconds": 14.59,
    "endSeconds": 18.04,
    "text": "The other princes walked past him without looking down.",
    "charStart": 177,
    "charEnd": 232
  },
  {
    "index": 6,
    "startSeconds": 18.04,
    "endSeconds": 21.4,
    "text": "The court women covered their mouths when they saw him.",
    "charStart": 233,
    "charEnd": 288
  },
  {
    "index": 7,
    "startSeconds": 21.4,
    "endSeconds": 30.5,
    "text": "The king's other wives found reasons to mention it — always gently, always cruelly — whenever Sogolon was nearby.",
    "charStart": 289,
    "charEnd": 402
  },
  {
    "index": 8,
    "startSeconds": 30.5,
    "endSeconds": 32.46,
    "text": "Your son, they would say.",
    "charStart": 404,
    "charEnd": 429
  },
  {
    "index": 9,
    "startSeconds": 32.46,
    "endSeconds": 34.27,
    "text": "How is your son today?",
    "charStart": 430,
    "charEnd": 452
  },
  {
    "index": 10,
    "startSeconds": 34.27,
    "endSeconds": 36.48,
    "text": "Sogolon bore this.",
    "charStart": 454,
    "charEnd": 472
  },
  {
    "index": 11,
    "startSeconds": 36.48,
    "endSeconds": 39.03,
    "text": "She was not a woman who bent easily.",
    "charStart": 473,
    "charEnd": 509
  },
  {
    "index": 12,
    "startSeconds": 39.03,
    "endSeconds": 47.19,
    "text": "But even she, on certain nights, when the palace was quiet and her boy slept and she sat alone, would feel the weight of it.",
    "charStart": 510,
    "charEnd": 634
  },
  {
    "index": 13,
    "startSeconds": 47.19,
    "endSeconds": 52.28,
    "text": "She had been promised, by a hunter's prophecy, that her son would be great.",
    "charStart": 636,
    "charEnd": 711
  },
  {
    "index": 14,
    "startSeconds": 52.28,
    "endSeconds": 56.01,
    "text": "That he would rule an empire the size of the sky.",
    "charStart": 712,
    "charEnd": 761
  },
  {
    "index": 15,
    "startSeconds": 56.01,
    "endSeconds": 63.54,
    "text": "Looking at him in the dust of the courtyard floor, it was very hard to believe.",
    "charStart": 763,
    "charEnd": 842
  },
  {
    "index": 16,
    "startSeconds": 63.54,
    "endSeconds": 64.68,
    "text": "But she believed it.",
    "charStart": 844,
    "charEnd": 864
  },
  {
    "index": 17,
    "startSeconds": 64.68,
    "endSeconds": 65.9,
    "text": "She always believed it.",
    "charStart": 866,
    "charEnd": 889
  }
]