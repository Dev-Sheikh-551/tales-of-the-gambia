[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.38,
    "text": "The king of Niani had many sons.",
    "charStart": 0,
    "charEnd": 32
  },
  {
    "index": 1,
    "startSeconds": 2.38,
    "endSeconds": 7.06,
    "text": "But one, born of a woman named Sogolon Condé, could not walk.",
    "charStart": 33,
    "charEnd": 94
  },
  {
    "index": 2,
    "startSeconds": 7.06,
    "endSeconds": 9.65,
    "text": "His name was Sundiata.",
    "charStart": 96,
    "charEnd": 118
  },
  {
    "index": 3,
    "startSeconds": 9.65,
    "endSeconds": 10.94,
    "text": "He crawled.",
    "charStart": 120,
    "charEnd": 131
  },
  {
    "index": 4,
    "startSeconds": 10.94,
    "endSeconds": 13.58,
    "text": "He dragged himself across the palace floors.",
    "charStart": 132,
    "charEnd": 176
  },
  {
    "index": 5,
    "startSeconds": 13.58,
    "endSeconds": 16.85,
    "text": "The other princes walked past him without looking down.",
    "charStart": 177,
    "charEnd": 232
  },
  {
    "index": 6,
    "startSeconds": 16.85,
    "endSeconds": 19.99,
    "text": "The court women covered their mouths when they saw him.",
    "charStart": 233,
    "charEnd": 288
  },
  {
    "index": 7,
    "startSeconds": 19.99,
    "endSeconds": 28.09,
    "text": "The king's other wives found reasons to mention it — always gently, always cruelly — whenever Sogolon was nearby.",
    "charStart": 289,
    "charEnd": 402
  },
  {
    "index": 8,
    "startSeconds": 28.09,
    "endSeconds": 31.78,
    "text": "Your son, they would say.",
    "charStart": 404,
    "charEnd": 429
  },
  {
    "index": 9,
    "startSeconds": 31.78,
    "endSeconds": 33.82,
    "text": "How is your son today?",
    "charStart": 430,
    "charEnd": 452
  },
  {
    "index": 10,
    "startSeconds": 33.82,
    "endSeconds": 36.2,
    "text": "Sogolon bore this.",
    "charStart": 454,
    "charEnd": 472
  },
  {
    "index": 11,
    "startSeconds": 36.2,
    "endSeconds": 38.24,
    "text": "She was not a woman who bent easily.",
    "charStart": 473,
    "charEnd": 509
  },
  {
    "index": 12,
    "startSeconds": 38.24,
    "endSeconds": 43.67,
    "text": "But even she, on certain nights, when the palace was quiet and her boy slept and she sat alone, would feel the weight of it.",
    "charStart": 510,
    "charEnd": 634
  },
  {
    "index": 13,
    "startSeconds": 43.67,
    "endSeconds": 48.25,
    "text": "She had been promised, by a hunter's prophecy, that her son would be great.",
    "charStart": 636,
    "charEnd": 711
  },
  {
    "index": 14,
    "startSeconds": 48.25,
    "endSeconds": 51.85,
    "text": "That he would rule an empire the size of the sky.",
    "charStart": 712,
    "charEnd": 761
  },
  {
    "index": 15,
    "startSeconds": 51.85,
    "endSeconds": 59.27,
    "text": "Looking at him in the dust of the courtyard floor, it was very hard to believe.",
    "charStart": 763,
    "charEnd": 842
  },
  {
    "index": 16,
    "startSeconds": 59.27,
    "endSeconds": 60.94,
    "text": "But she believed it.",
    "charStart": 844,
    "charEnd": 864
  },
  {
    "index": 17,
    "startSeconds": 60.94,
    "endSeconds": 61.67,
    "text": "She always believed it.",
    "charStart": 866,
    "charEnd": 889
  }
]