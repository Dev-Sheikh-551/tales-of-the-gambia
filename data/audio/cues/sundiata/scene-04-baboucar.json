[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 3.2,
    "text": "Standing was not the end of Sundiata's struggle.",
    "charStart": 0,
    "charEnd": 48
  },
  {
    "index": 1,
    "startSeconds": 3.2,
    "endSeconds": 4.96,
    "text": "It was the beginning.",
    "charStart": 49,
    "charEnd": 70
  },
  {
    "index": 2,
    "startSeconds": 4.96,
    "endSeconds": 12.06,
    "text": "The queen mother of Niani — the mother of the king's other sons — understood what Sundiata's rise meant.",
    "charStart": 72,
    "charEnd": 176
  },
  {
    "index": 3,
    "startSeconds": 12.06,
    "endSeconds": 16.74,
    "text": "If this boy who had once crawled in the dust could stand, what else might he do?",
    "charStart": 177,
    "charEnd": 257
  },
  {
    "index": 4,
    "startSeconds": 16.74,
    "endSeconds": 18.57,
    "text": "What throne might he reach?",
    "charStart": 258,
    "charEnd": 285
  },
  {
    "index": 5,
    "startSeconds": 18.57,
    "endSeconds": 23.02,
    "text": "Her own sons' futures depended on Sundiata's disappearance.",
    "charStart": 286,
    "charEnd": 345
  },
  {
    "index": 6,
    "startSeconds": 23.02,
    "endSeconds": 25.03,
    "text": "And so the pressure built.",
    "charStart": 347,
    "charEnd": 373
  },
  {
    "index": 7,
    "startSeconds": 25.03,
    "endSeconds": 26.61,
    "text": "The whispers grew.",
    "charStart": 374,
    "charEnd": 392
  },
  {
    "index": 8,
    "startSeconds": 26.61,
    "endSeconds": 34.83,
    "text": "The threats came — quietly, in the language that courts use when they want to be rid of someone without the messiness of an open confrontation.",
    "charStart": 393,
    "charEnd": 536
  },
  {
    "index": 9,
    "startSeconds": 34.83,
    "endSeconds": 37.29,
    "text": "Sogolon read the signs.",
    "charStart": 538,
    "charEnd": 561
  },
  {
    "index": 10,
    "startSeconds": 37.29,
    "endSeconds": 41.63,
    "text": "She had not survived this long by being slow to understand danger.",
    "charStart": 562,
    "charEnd": 628
  },
  {
    "index": 11,
    "startSeconds": 41.63,
    "endSeconds": 46.14,
    "text": "She took her children — Sundiata and his siblings — and she left.",
    "charStart": 630,
    "charEnd": 695
  },
  {
    "index": 12,
    "startSeconds": 46.14,
    "endSeconds": 52.03,
    "text": "They wandered from kingdom to kingdom across the Mande world: Djedeba, Tabon, Mema.",
    "charStart": 697,
    "charEnd": 780
  },
  {
    "index": 13,
    "startSeconds": 52.03,
    "endSeconds": 55.55,
    "text": "Everywhere they went, Sogolon held her family together.",
    "charStart": 781,
    "charEnd": 836
  },
  {
    "index": 14,
    "startSeconds": 55.55,
    "endSeconds": 63.66,
    "text": "Everywhere they went, Sundiata grew — in height, in strength, in the particular quality that would one day make kings kneel before him.",
    "charStart": 837,
    "charEnd": 972
  },
  {
    "index": 15,
    "startSeconds": 63.66,
    "endSeconds": 66.36,
    "text": "He was learning the world from the outside.",
    "charStart": 974,
    "charEnd": 1017
  },
  {
    "index": 16,
    "startSeconds": 66.36,
    "endSeconds": 70.0,
    "text": "And that, the griots say, was part of the plan.",
    "charStart": 1018,
    "charEnd": 1065
  }
]