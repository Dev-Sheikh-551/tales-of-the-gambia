[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 4.44,
    "text": "One morning, Demba rose before the sun and went to count his herd.",
    "charStart": 0,
    "charEnd": 66
  },
  {
    "index": 1,
    "startSeconds": 4.44,
    "endSeconds": 7.02,
    "text": "Forty cattle.",
    "charStart": 68,
    "charEnd": 81
  },
  {
    "index": 2,
    "startSeconds": 7.02,
    "endSeconds": 9.72,
    "text": "Not forty-three.",
    "charStart": 82,
    "charEnd": 98
  },
  {
    "index": 3,
    "startSeconds": 9.72,
    "endSeconds": 11.79,
    "text": "He counted again.",
    "charStart": 100,
    "charEnd": 117
  },
  {
    "index": 4,
    "startSeconds": 11.79,
    "endSeconds": 14.81,
    "text": "Still forty.",
    "charStart": 118,
    "charEnd": 130
  },
  {
    "index": 5,
    "startSeconds": 14.81,
    "endSeconds": 17.67,
    "text": "His three finest animals — a large bull and two young cows — were gone.",
    "charStart": 132,
    "charEnd": 203
  },
  {
    "index": 6,
    "startSeconds": 17.67,
    "endSeconds": 20.36,
    "text": "Demba stood in the field for a long moment.",
    "charStart": 205,
    "charEnd": 248
  },
  {
    "index": 7,
    "startSeconds": 20.36,
    "endSeconds": 22.61,
    "text": "The sky was the colour of old iron.",
    "charStart": 249,
    "charEnd": 284
  },
  {
    "index": 8,
    "startSeconds": 22.61,
    "endSeconds": 24.7,
    "text": "The remaining cattle stood quietly, breathing in the cold morning air.",
    "charStart": 285,
    "charEnd": 355
  },
  {
    "index": 9,
    "startSeconds": 24.7,
    "endSeconds": 27.69,
    "text": "Around him, the village was still sleeping.",
    "charStart": 356,
    "charEnd": 399
  },
  {
    "index": 10,
    "startSeconds": 27.69,
    "endSeconds": 29.4,
    "text": "He asked questions.",
    "charStart": 401,
    "charEnd": 420
  },
  {
    "index": 11,
    "startSeconds": 29.4,
    "endSeconds": 30.84,
    "text": "He tracked footprints.",
    "charStart": 421,
    "charEnd": 443
  },
  {
    "index": 12,
    "startSeconds": 30.84,
    "endSeconds": 39.0,
    "text": "By midday, he knew: the animals had been taken by Musa, a man from the neighbouring village, who had long coveted Demba's bull.",
    "charStart": 444,
    "charEnd": 571
  },
  {
    "index": 13,
    "startSeconds": 39.0,
    "endSeconds": 40.96,
    "text": "Everyone in the village knew it.",
    "charStart": 573,
    "charEnd": 605
  },
  {
    "index": 14,
    "startSeconds": 40.96,
    "endSeconds": 43.61,
    "text": "The footprints led to Musa's compound.",
    "charStart": 606,
    "charEnd": 644
  },
  {
    "index": 15,
    "startSeconds": 43.61,
    "endSeconds": 46.6,
    "text": "Musa's compound had three new animals.",
    "charStart": 645,
    "charEnd": 683
  },
  {
    "index": 16,
    "startSeconds": 46.6,
    "endSeconds": 49.71,
    "text": "The math, as they say, was not difficult.",
    "charStart": 684,
    "charEnd": 725
  },
  {
    "index": 17,
    "startSeconds": 49.71,
    "endSeconds": 52.74,
    "text": "Now every eye in the village turned to Demba.",
    "charStart": 727,
    "charEnd": 772
  },
  {
    "index": 18,
    "startSeconds": 52.74,
    "endSeconds": 54.55,
    "text": "What would he do?",
    "charStart": 774,
    "charEnd": 791
  }
]