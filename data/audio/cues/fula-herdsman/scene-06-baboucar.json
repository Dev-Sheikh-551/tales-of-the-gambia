[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.06,
    "text": "Munyal.",
    "charStart": 0,
    "charEnd": 7
  },
  {
    "index": 1,
    "startSeconds": 2.06,
    "endSeconds": 5.71,
    "text": "Patience.",
    "charStart": 8,
    "charEnd": 17
  },
  {
    "index": 2,
    "startSeconds": 5.71,
    "endSeconds": 8.51,
    "text": "It is the first and highest value of Pulaaku.",
    "charStart": 19,
    "charEnd": 64
  },
  {
    "index": 3,
    "startSeconds": 8.51,
    "endSeconds": 13.02,
    "text": "Not courage in the sense of rushing forward — but courage in the sense of holding still when everything in you wants to move.",
    "charStart": 65,
    "charEnd": 190
  },
  {
    "index": 4,
    "startSeconds": 13.02,
    "endSeconds": 17.69,
    "text": "Of maintaining your dignity when the world gives you every reason to lose it.",
    "charStart": 191,
    "charEnd": 268
  },
  {
    "index": 5,
    "startSeconds": 17.69,
    "endSeconds": 23.46,
    "text": "The Fula have a saying: Munyal ko dow fuu.",
    "charStart": 270,
    "charEnd": 312
  },
  {
    "index": 6,
    "startSeconds": 23.46,
    "endSeconds": 25.8,
    "text": "Patience is above everything.",
    "charStart": 313,
    "charEnd": 342
  },
  {
    "index": 7,
    "startSeconds": 25.8,
    "endSeconds": 32.51,
    "text": "This is not a passive idea.",
    "charStart": 344,
    "charEnd": 371
  },
  {
    "index": 8,
    "startSeconds": 32.51,
    "endSeconds": 34.44,
    "text": "A Fula herdsman who rises before dawn every morning for forty years understands that patience is a form of work.",
    "charStart": 372,
    "charEnd": 484
  },
  {
    "index": 9,
    "startSeconds": 34.44,
    "endSeconds": 35.91,
    "text": "The most demanding form.",
    "charStart": 485,
    "charEnd": 509
  },
  {
    "index": 10,
    "startSeconds": 35.91,
    "endSeconds": 37.39,
    "text": "Anyone can shout.",
    "charStart": 510,
    "charEnd": 527
  },
  {
    "index": 11,
    "startSeconds": 37.39,
    "endSeconds": 40.27,
    "text": "Anyone can attack.",
    "charStart": 528,
    "charEnd": 546
  },
  {
    "index": 12,
    "startSeconds": 40.27,
    "endSeconds": 50.64,
    "text": "But to absorb an injury, to endure, to wait — and to do all of this without bitterness, without losing your sense of who you are — this requires something deeper than ordinary courage.",
    "charStart": 547,
    "charEnd": 731
  },
  {
    "index": 13,
    "startSeconds": 50.64,
    "endSeconds": 54.18,
    "text": "Demba understood this.",
    "charStart": 733,
    "charEnd": 755
  },
  {
    "index": 14,
    "startSeconds": 54.18,
    "endSeconds": 62.12,
    "text": "He tended his forty-three cattle — back to forty-three now — as the sun went down over the Gambia River.",
    "charStart": 757,
    "charEnd": 861
  },
  {
    "index": 15,
    "startSeconds": 62.12,
    "endSeconds": 64.84,
    "text": "The sky was the colour of mango skin.",
    "charStart": 862,
    "charEnd": 899
  },
  {
    "index": 16,
    "startSeconds": 64.84,
    "endSeconds": 67.05,
    "text": "The animals were calm.",
    "charStart": 900,
    "charEnd": 922
  },
  {
    "index": 17,
    "startSeconds": 67.05,
    "endSeconds": 69.54,
    "text": "He counted them one by one.",
    "charStart": 924,
    "charEnd": 951
  },
  {
    "index": 18,
    "startSeconds": 69.54,
    "endSeconds": 71.18,
    "text": "Each one had a name.",
    "charStart": 953,
    "charEnd": 973
  },
  {
    "index": 19,
    "startSeconds": 71.18,
    "endSeconds": 72.2,
    "text": "He said each name aloud.",
    "charStart": 975,
    "charEnd": 999
  },
  {
    "index": 20,
    "startSeconds": 72.2,
    "endSeconds": 72.83,
    "text": "And everything was as it should be.",
    "charStart": 1001,
    "charEnd": 1036
  }
]