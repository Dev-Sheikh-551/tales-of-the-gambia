[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 1.62,
    "text": "Demba waited.",
    "charStart": 0,
    "charEnd": 13
  },
  {
    "index": 1,
    "startSeconds": 1.62,
    "endSeconds": 11.53,
    "text": "He tended his remaining forty cattle with the same care as before — rising before dawn, walking them to the best grazing land, counting them at dusk.",
    "charStart": 15,
    "charEnd": 164
  },
  {
    "index": 2,
    "startSeconds": 11.53,
    "endSeconds": 13.61,
    "text": "He said nothing about Musa.",
    "charStart": 165,
    "charEnd": 192
  },
  {
    "index": 3,
    "startSeconds": 13.61,
    "endSeconds": 15.15,
    "text": "He did not appear angry.",
    "charStart": 193,
    "charEnd": 217
  },
  {
    "index": 4,
    "startSeconds": 15.15,
    "endSeconds": 17.7,
    "text": "He did not avoid Musa in the market.",
    "charStart": 218,
    "charEnd": 254
  },
  {
    "index": 5,
    "startSeconds": 17.7,
    "endSeconds": 20.74,
    "text": "The village watched and could not understand.",
    "charStart": 256,
    "charEnd": 301
  },
  {
    "index": 6,
    "startSeconds": 20.74,
    "endSeconds": 23.75,
    "text": "\"Demba has lost his spine,\" some said.",
    "charStart": 303,
    "charEnd": 341
  },
  {
    "index": 7,
    "startSeconds": 23.75,
    "endSeconds": 27.01,
    "text": "\"Demba is waiting for something,\" others said.",
    "charStart": 343,
    "charEnd": 389
  },
  {
    "index": 8,
    "startSeconds": 27.01,
    "endSeconds": 30.87,
    "text": "The old man under the tamarind tree said nothing at all.",
    "charStart": 391,
    "charEnd": 447
  },
  {
    "index": 9,
    "startSeconds": 30.87,
    "endSeconds": 35.88,
    "text": "And Musa — in the neighbouring village — grew more and more uncomfortable.",
    "charStart": 449,
    "charEnd": 523
  },
  {
    "index": 10,
    "startSeconds": 35.88,
    "endSeconds": 38.13,
    "text": "He had expected a confrontation.",
    "charStart": 524,
    "charEnd": 556
  },
  {
    "index": 11,
    "startSeconds": 38.13,
    "endSeconds": 39.86,
    "text": "He had expected rage.",
    "charStart": 557,
    "charEnd": 578
  },
  {
    "index": 12,
    "startSeconds": 39.86,
    "endSeconds": 49.81,
    "text": "He had expected Demba to arrive at his compound with hard words and a crowd, so that Musa could stand his ground in front of witnesses and make the whole thing messy.",
    "charStart": 579,
    "charEnd": 745
  },
  {
    "index": 13,
    "startSeconds": 49.81,
    "endSeconds": 53.9,
    "text": "But there was no confrontation.",
    "charStart": 747,
    "charEnd": 778
  },
  {
    "index": 14,
    "startSeconds": 53.9,
    "endSeconds": 55.07,
    "text": "No rage.",
    "charStart": 779,
    "charEnd": 787
  },
  {
    "index": 15,
    "startSeconds": 55.07,
    "endSeconds": 57.21,
    "text": "No crowd.",
    "charStart": 788,
    "charEnd": 797
  },
  {
    "index": 16,
    "startSeconds": 57.21,
    "endSeconds": 59.09,
    "text": "Just Demba, calmly tending his forty cattle.",
    "charStart": 799,
    "charEnd": 843
  },
  {
    "index": 17,
    "startSeconds": 59.09,
    "endSeconds": 65.08,
    "text": "And that — that stillness, that patience, that refusal to be provoked — was more frightening than any anger could have been.",
    "charStart": 845,
    "charEnd": 969
  }
]