[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 3.04,
    "text": "His neighbours were angry on his behalf.",
    "charStart": 0,
    "charEnd": 40
  },
  {
    "index": 1,
    "startSeconds": 3.04,
    "endSeconds": 7.88,
    "text": "Young men volunteered to accompany him to Musa's compound.",
    "charStart": 42,
    "charEnd": 100
  },
  {
    "index": 2,
    "startSeconds": 7.88,
    "endSeconds": 17.77,
    "text": "They spoke the language of justice, but their eyes held the heat of excitement — the particular brightness of men who want to see a confrontation.",
    "charStart": 101,
    "charEnd": 247
  },
  {
    "index": 3,
    "startSeconds": 17.77,
    "endSeconds": 20.42,
    "text": "Demba listened to all of them.",
    "charStart": 249,
    "charEnd": 279
  },
  {
    "index": 4,
    "startSeconds": 20.42,
    "endSeconds": 23.93,
    "text": "Then he went to find the eldest man in the village.",
    "charStart": 281,
    "charEnd": 332
  },
  {
    "index": 5,
    "startSeconds": 23.93,
    "endSeconds": 34.25,
    "text": "The old man was sitting under a tamarind tree, shelling groundnuts with slow, methodical hands.",
    "charStart": 334,
    "charEnd": 429
  },
  {
    "index": 6,
    "startSeconds": 34.25,
    "endSeconds": 37.03,
    "text": "He did not look up when Demba sat beside him.",
    "charStart": 430,
    "charEnd": 475
  },
  {
    "index": 7,
    "startSeconds": 37.03,
    "endSeconds": 39.19,
    "text": "\"You already know,\" Demba said.",
    "charStart": 477,
    "charEnd": 508
  },
  {
    "index": 8,
    "startSeconds": 39.19,
    "endSeconds": 43.49,
    "text": "\"The whole village knows,\" the old man said.",
    "charStart": 510,
    "charEnd": 554
  },
  {
    "index": 9,
    "startSeconds": 43.49,
    "endSeconds": 46.47,
    "text": "\"I am waiting to see what kind of man you are.\"",
    "charStart": 555,
    "charEnd": 602
  },
  {
    "index": 10,
    "startSeconds": 46.47,
    "endSeconds": 48.1,
    "text": "\"My cattle are in Musa's compound.\"",
    "charStart": 604,
    "charEnd": 639
  },
  {
    "index": 11,
    "startSeconds": 48.1,
    "endSeconds": 51.21,
    "text": "\"Yes.\"",
    "charStart": 641,
    "charEnd": 647
  },
  {
    "index": 12,
    "startSeconds": 51.21,
    "endSeconds": 53.48,
    "text": "\"My blood says to go and take them back.\"",
    "charStart": 649,
    "charEnd": 690
  },
  {
    "index": 13,
    "startSeconds": 53.48,
    "endSeconds": 57.65,
    "text": "The old man looked up then.",
    "charStart": 692,
    "charEnd": 719
  },
  {
    "index": 14,
    "startSeconds": 57.65,
    "endSeconds": 62.46,
    "text": "His eyes were the colour of dry ground in the harmattan season — pale and deep at the same time.",
    "charStart": 720,
    "charEnd": 816
  },
  {
    "index": 15,
    "startSeconds": 62.46,
    "endSeconds": 65.39,
    "text": "\"And what does Pulaaku say?\"",
    "charStart": 817,
    "charEnd": 845
  },
  {
    "index": 16,
    "startSeconds": 65.39,
    "endSeconds": 67.58,
    "text": "Demba was quiet for a long time.",
    "charStart": 847,
    "charEnd": 879
  },
  {
    "index": 17,
    "startSeconds": 67.58,
    "endSeconds": 69.97,
    "text": "\"Pulaaku says wait.\"",
    "charStart": 881,
    "charEnd": 901
  },
  {
    "index": 18,
    "startSeconds": 69.97,
    "endSeconds": 71.78,
    "text": "The old man nodded slowly.",
    "charStart": 903,
    "charEnd": 929
  },
  {
    "index": 19,
    "startSeconds": 71.78,
    "endSeconds": 72.4,
    "text": "\"Then you already know what to do.\"",
    "charStart": 930,
    "charEnd": 965
  }
]