[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.32,
    "text": "Munyal.",
    "charStart": 0,
    "charEnd": 7
  },
  {
    "index": 1,
    "startSeconds": 2.32,
    "endSeconds": 6.16,
    "text": "Patience.",
    "charStart": 8,
    "charEnd": 17
  },
  {
    "index": 2,
    "startSeconds": 6.16,
    "endSeconds": 9.14,
    "text": "It is the first and highest value of Pulaaku.",
    "charStart": 19,
    "charEnd": 64
  },
  {
    "index": 3,
    "startSeconds": 9.14,
    "endSeconds": 13.94,
    "text": "Not courage in the sense of rushing forward — but courage in the sense of holding still when everything in you wants to move.",
    "charStart": 65,
    "charEnd": 190
  },
  {
    "index": 4,
    "startSeconds": 13.94,
    "endSeconds": 18.7,
    "text": "Of maintaining your dignity when the world gives you every reason to lose it.",
    "charStart": 191,
    "charEnd": 268
  },
  {
    "index": 5,
    "startSeconds": 18.7,
    "endSeconds": 24.62,
    "text": "The Fula have a saying: Munyal ko dow fuu.",
    "charStart": 270,
    "charEnd": 312
  },
  {
    "index": 6,
    "startSeconds": 24.62,
    "endSeconds": 27.03,
    "text": "Patience is above everything.",
    "charStart": 313,
    "charEnd": 342
  },
  {
    "index": 7,
    "startSeconds": 27.03,
    "endSeconds": 34.48,
    "text": "This is not a passive idea.",
    "charStart": 344,
    "charEnd": 371
  },
  {
    "index": 8,
    "startSeconds": 34.48,
    "endSeconds": 36.51,
    "text": "A Fula herdsman who rises before dawn every morning for forty years understands that patience is a form of work.",
    "charStart": 372,
    "charEnd": 484
  },
  {
    "index": 9,
    "startSeconds": 36.51,
    "endSeconds": 38.19,
    "text": "The most demanding form.",
    "charStart": 485,
    "charEnd": 509
  },
  {
    "index": 10,
    "startSeconds": 38.19,
    "endSeconds": 39.88,
    "text": "Anyone can shout.",
    "charStart": 510,
    "charEnd": 527
  },
  {
    "index": 11,
    "startSeconds": 39.88,
    "endSeconds": 43.22,
    "text": "Anyone can attack.",
    "charStart": 528,
    "charEnd": 546
  },
  {
    "index": 12,
    "startSeconds": 43.22,
    "endSeconds": 53.99,
    "text": "But to absorb an injury, to endure, to wait — and to do all of this without bitterness, without losing your sense of who you are — this requires something deeper than ordinary courage.",
    "charStart": 547,
    "charEnd": 731
  },
  {
    "index": 13,
    "startSeconds": 53.99,
    "endSeconds": 56.39,
    "text": "Demba understood this.",
    "charStart": 733,
    "charEnd": 755
  },
  {
    "index": 14,
    "startSeconds": 56.39,
    "endSeconds": 64.3,
    "text": "He tended his forty-three cattle — back to forty-three now — as the sun went down over the Gambia River.",
    "charStart": 757,
    "charEnd": 861
  },
  {
    "index": 15,
    "startSeconds": 64.3,
    "endSeconds": 66.36,
    "text": "The sky was the colour of mango skin.",
    "charStart": 862,
    "charEnd": 899
  },
  {
    "index": 16,
    "startSeconds": 66.36,
    "endSeconds": 68.86,
    "text": "The animals were calm.",
    "charStart": 900,
    "charEnd": 922
  },
  {
    "index": 17,
    "startSeconds": 68.86,
    "endSeconds": 70.97,
    "text": "He counted them one by one.",
    "charStart": 924,
    "charEnd": 951
  },
  {
    "index": 18,
    "startSeconds": 70.97,
    "endSeconds": 73.31,
    "text": "Each one had a name.",
    "charStart": 953,
    "charEnd": 973
  },
  {
    "index": 19,
    "startSeconds": 73.31,
    "endSeconds": 74.96,
    "text": "He said each name aloud.",
    "charStart": 975,
    "charEnd": 999
  },
  {
    "index": 20,
    "startSeconds": 74.96,
    "endSeconds": 76.45,
    "text": "And everything was as it should be.",
    "charStart": 1001,
    "charEnd": 1036
  }
]