[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 5.65,
    "text": "Three weeks after the theft, Musa sent a young man to Demba's compound.",
    "charStart": 0,
    "charEnd": 71
  },
  {
    "index": 1,
    "startSeconds": 5.65,
    "endSeconds": 8.44,
    "text": "The young man carried an apology.",
    "charStart": 73,
    "charEnd": 106
  },
  {
    "index": 2,
    "startSeconds": 8.44,
    "endSeconds": 11.93,
    "text": "He carried a promise to return the three animals.",
    "charStart": 107,
    "charEnd": 156
  },
  {
    "index": 3,
    "startSeconds": 11.93,
    "endSeconds": 17.16,
    "text": "He also carried two additional goats, offered as the payment of shame.",
    "charStart": 157,
    "charEnd": 227
  },
  {
    "index": 4,
    "startSeconds": 17.16,
    "endSeconds": 20.34,
    "text": "Demba received the young man courteously.",
    "charStart": 229,
    "charEnd": 270
  },
  {
    "index": 5,
    "startSeconds": 20.34,
    "endSeconds": 26.28,
    "text": "He offered him water and food, as one does with any guest.",
    "charStart": 271,
    "charEnd": 329
  },
  {
    "index": 6,
    "startSeconds": 26.28,
    "endSeconds": 29.9,
    "text": "He said only this:",
    "charStart": 330,
    "charEnd": 348
  },
  {
    "index": 7,
    "startSeconds": 29.9,
    "endSeconds": 32.59,
    "text": "\"Tell Musa that I hold no anger toward him.",
    "charStart": 350,
    "charEnd": 393
  },
  {
    "index": 8,
    "startSeconds": 32.59,
    "endSeconds": 35.03,
    "text": "Tell him that the cattle may come home whenever he is ready to bring them.\"",
    "charStart": 394,
    "charEnd": 469
  },
  {
    "index": 9,
    "startSeconds": 35.03,
    "endSeconds": 39.06,
    "text": "The three cattle were returned the following morning.",
    "charStart": 471,
    "charEnd": 524
  },
  {
    "index": 10,
    "startSeconds": 39.06,
    "endSeconds": 47.09,
    "text": "When Demba brought the news to the old man under the tamarind tree, the elder smiled for the first time in weeks.",
    "charStart": 526,
    "charEnd": 639
  },
  {
    "index": 11,
    "startSeconds": 47.09,
    "endSeconds": 49.76,
    "text": "\"You see?\"",
    "charStart": 641,
    "charEnd": 651
  },
  {
    "index": 12,
    "startSeconds": 49.76,
    "endSeconds": 52.53,
    "text": "the old man said.",
    "charStart": 652,
    "charEnd": 669
  },
  {
    "index": 13,
    "startSeconds": 52.53,
    "endSeconds": 55.7,
    "text": "\"Musa expected a battle he could fight.",
    "charStart": 670,
    "charEnd": 709
  },
  {
    "index": 14,
    "startSeconds": 55.7,
    "endSeconds": 57.94,
    "text": "You gave him a silence he could not survive.\"",
    "charStart": 710,
    "charEnd": 755
  },
  {
    "index": 15,
    "startSeconds": 57.94,
    "endSeconds": 60.97,
    "text": "Demba sat beside him and watched the village go about its business.",
    "charStart": 757,
    "charEnd": 824
  },
  {
    "index": 16,
    "startSeconds": 60.97,
    "endSeconds": 65.27,
    "text": "\"It was the hardest thing I have ever done,\" Demba said.",
    "charStart": 826,
    "charEnd": 882
  },
  {
    "index": 17,
    "startSeconds": 65.27,
    "endSeconds": 67.83,
    "text": "\"Yes,\" the old man agreed.",
    "charStart": 884,
    "charEnd": 910
  },
  {
    "index": 18,
    "startSeconds": 67.83,
    "endSeconds": 70.97,
    "text": "\"That is why Pulaaku is worth keeping.\"",
    "charStart": 911,
    "charEnd": 950
  }
]