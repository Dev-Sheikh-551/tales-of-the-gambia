[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 3.23,
    "text": "His neighbours were angry on his behalf.",
    "charStart": 0,
    "charEnd": 40
  },
  {
    "index": 1,
    "startSeconds": 3.23,
    "endSeconds": 8.09,
    "text": "Young men volunteered to accompany him to Musa's compound.",
    "charStart": 42,
    "charEnd": 100
  },
  {
    "index": 2,
    "startSeconds": 8.09,
    "endSeconds": 20.9,
    "text": "They spoke the language of justice, but their eyes held the heat of excitement — the particular brightness of men who want to see a confrontation.",
    "charStart": 101,
    "charEnd": 247
  },
  {
    "index": 3,
    "startSeconds": 20.9,
    "endSeconds": 24.67,
    "text": "Demba listened to all of them.",
    "charStart": 249,
    "charEnd": 279
  },
  {
    "index": 4,
    "startSeconds": 24.67,
    "endSeconds": 28.04,
    "text": "Then he went to find the eldest man in the village.",
    "charStart": 281,
    "charEnd": 332
  },
  {
    "index": 5,
    "startSeconds": 28.04,
    "endSeconds": 35.21,
    "text": "The old man was sitting under a tamarind tree, shelling groundnuts with slow, methodical hands.",
    "charStart": 334,
    "charEnd": 429
  },
  {
    "index": 6,
    "startSeconds": 35.21,
    "endSeconds": 38.06,
    "text": "He did not look up when Demba sat beside him.",
    "charStart": 430,
    "charEnd": 475
  },
  {
    "index": 7,
    "startSeconds": 38.06,
    "endSeconds": 40.15,
    "text": "\"You already know,\" Demba said.",
    "charStart": 477,
    "charEnd": 508
  },
  {
    "index": 8,
    "startSeconds": 40.15,
    "endSeconds": 44.61,
    "text": "\"The whole village knows,\" the old man said.",
    "charStart": 510,
    "charEnd": 554
  },
  {
    "index": 9,
    "startSeconds": 44.61,
    "endSeconds": 47.89,
    "text": "\"I am waiting to see what kind of man you are.\"",
    "charStart": 555,
    "charEnd": 602
  },
  {
    "index": 10,
    "startSeconds": 47.89,
    "endSeconds": 49.5,
    "text": "\"My cattle are in Musa's compound.\"",
    "charStart": 604,
    "charEnd": 639
  },
  {
    "index": 11,
    "startSeconds": 49.5,
    "endSeconds": 52.63,
    "text": "\"Yes.\"",
    "charStart": 641,
    "charEnd": 647
  },
  {
    "index": 12,
    "startSeconds": 52.63,
    "endSeconds": 54.88,
    "text": "\"My blood says to go and take them back.\"",
    "charStart": 649,
    "charEnd": 690
  },
  {
    "index": 13,
    "startSeconds": 54.88,
    "endSeconds": 59.18,
    "text": "The old man looked up then.",
    "charStart": 692,
    "charEnd": 719
  },
  {
    "index": 14,
    "startSeconds": 59.18,
    "endSeconds": 64.2,
    "text": "His eyes were the colour of dry ground in the harmattan season — pale and deep at the same time.",
    "charStart": 720,
    "charEnd": 816
  },
  {
    "index": 15,
    "startSeconds": 64.2,
    "endSeconds": 67.3,
    "text": "\"And what does Pulaaku say?\"",
    "charStart": 817,
    "charEnd": 845
  },
  {
    "index": 16,
    "startSeconds": 67.3,
    "endSeconds": 69.61,
    "text": "Demba was quiet for a long time.",
    "charStart": 847,
    "charEnd": 879
  },
  {
    "index": 17,
    "startSeconds": 69.61,
    "endSeconds": 71.99,
    "text": "\"Pulaaku says wait.\"",
    "charStart": 881,
    "charEnd": 901
  },
  {
    "index": 18,
    "startSeconds": 71.99,
    "endSeconds": 72.58,
    "text": "The old man nodded slowly.",
    "charStart": 903,
    "charEnd": 929
  },
  {
    "index": 19,
    "startSeconds": 72.58,
    "endSeconds": 74.53,
    "text": "\"Then you already know what to do.\"",
    "charStart": 930,
    "charEnd": 965
  }
]