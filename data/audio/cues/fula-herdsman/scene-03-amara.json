[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.74,
    "text": "His neighbours were angry on his behalf.",
    "charStart": 0,
    "charEnd": 40
  },
  {
    "index": 1,
    "startSeconds": 2.74,
    "endSeconds": 7.19,
    "text": "Young men volunteered to accompany him to Musa's compound.",
    "charStart": 42,
    "charEnd": 100
  },
  {
    "index": 2,
    "startSeconds": 7.19,
    "endSeconds": 16.38,
    "text": "They spoke the language of justice, but their eyes held the heat of excitement — the particular brightness of men who want to see a confrontation.",
    "charStart": 101,
    "charEnd": 247
  },
  {
    "index": 3,
    "startSeconds": 16.38,
    "endSeconds": 18.76,
    "text": "Demba listened to all of them.",
    "charStart": 249,
    "charEnd": 279
  },
  {
    "index": 4,
    "startSeconds": 18.76,
    "endSeconds": 22.03,
    "text": "Then he went to find the eldest man in the village.",
    "charStart": 281,
    "charEnd": 332
  },
  {
    "index": 5,
    "startSeconds": 22.03,
    "endSeconds": 31.35,
    "text": "The old man was sitting under a tamarind tree, shelling groundnuts with slow, methodical hands.",
    "charStart": 334,
    "charEnd": 429
  },
  {
    "index": 6,
    "startSeconds": 31.35,
    "endSeconds": 33.87,
    "text": "He did not look up when Demba sat beside him.",
    "charStart": 430,
    "charEnd": 475
  },
  {
    "index": 7,
    "startSeconds": 33.87,
    "endSeconds": 35.71,
    "text": "\"You already know,\" Demba said.",
    "charStart": 477,
    "charEnd": 508
  },
  {
    "index": 8,
    "startSeconds": 35.71,
    "endSeconds": 39.58,
    "text": "\"The whole village knows,\" the old man said.",
    "charStart": 510,
    "charEnd": 554
  },
  {
    "index": 9,
    "startSeconds": 39.58,
    "endSeconds": 42.36,
    "text": "\"I am waiting to see what kind of man you are.\"",
    "charStart": 555,
    "charEnd": 602
  },
  {
    "index": 10,
    "startSeconds": 42.36,
    "endSeconds": 43.81,
    "text": "\"My cattle are in Musa's compound.\"",
    "charStart": 604,
    "charEnd": 639
  },
  {
    "index": 11,
    "startSeconds": 43.81,
    "endSeconds": 46.62,
    "text": "\"Yes.\"",
    "charStart": 641,
    "charEnd": 647
  },
  {
    "index": 12,
    "startSeconds": 46.62,
    "endSeconds": 48.61,
    "text": "\"My blood says to go and take them back.\"",
    "charStart": 649,
    "charEnd": 690
  },
  {
    "index": 13,
    "startSeconds": 48.61,
    "endSeconds": 52.46,
    "text": "The old man looked up then.",
    "charStart": 692,
    "charEnd": 719
  },
  {
    "index": 14,
    "startSeconds": 52.46,
    "endSeconds": 56.85,
    "text": "His eyes were the colour of dry ground in the harmattan season — pale and deep at the same time.",
    "charStart": 720,
    "charEnd": 816
  },
  {
    "index": 15,
    "startSeconds": 56.85,
    "endSeconds": 59.46,
    "text": "\"And what does Pulaaku say?\"",
    "charStart": 817,
    "charEnd": 845
  },
  {
    "index": 16,
    "startSeconds": 59.46,
    "endSeconds": 61.43,
    "text": "Demba was quiet for a long time.",
    "charStart": 847,
    "charEnd": 879
  },
  {
    "index": 17,
    "startSeconds": 61.43,
    "endSeconds": 63.54,
    "text": "\"Pulaaku says wait.\"",
    "charStart": 881,
    "charEnd": 901
  },
  {
    "index": 18,
    "startSeconds": 63.54,
    "endSeconds": 64.76,
    "text": "The old man nodded slowly.",
    "charStart": 903,
    "charEnd": 929
  },
  {
    "index": 19,
    "startSeconds": 64.76,
    "endSeconds": 65.72,
    "text": "\"Then you already know what to do.\"",
    "charStart": 930,
    "charEnd": 965
  }
]