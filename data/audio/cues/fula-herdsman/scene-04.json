[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 1.9,
    "text": "Demba waited.",
    "charStart": 0,
    "charEnd": 13
  },
  {
    "index": 1,
    "startSeconds": 1.9,
    "endSeconds": 12.78,
    "text": "He tended his remaining forty cattle with the same care as before — rising before dawn, walking them to the best grazing land, counting them at dusk.",
    "charStart": 15,
    "charEnd": 164
  },
  {
    "index": 2,
    "startSeconds": 12.78,
    "endSeconds": 15.09,
    "text": "He said nothing about Musa.",
    "charStart": 165,
    "charEnd": 192
  },
  {
    "index": 3,
    "startSeconds": 15.09,
    "endSeconds": 16.89,
    "text": "He did not appear angry.",
    "charStart": 193,
    "charEnd": 217
  },
  {
    "index": 4,
    "startSeconds": 16.89,
    "endSeconds": 19.71,
    "text": "He did not avoid Musa in the market.",
    "charStart": 218,
    "charEnd": 254
  },
  {
    "index": 5,
    "startSeconds": 19.71,
    "endSeconds": 23.13,
    "text": "The village watched and could not understand.",
    "charStart": 256,
    "charEnd": 301
  },
  {
    "index": 6,
    "startSeconds": 23.13,
    "endSeconds": 26.56,
    "text": "\"Demba has lost his spine,\" some said.",
    "charStart": 303,
    "charEnd": 341
  },
  {
    "index": 7,
    "startSeconds": 26.56,
    "endSeconds": 30.28,
    "text": "\"Demba is waiting for something,\" others said.",
    "charStart": 343,
    "charEnd": 389
  },
  {
    "index": 8,
    "startSeconds": 30.28,
    "endSeconds": 34.74,
    "text": "The old man under the tamarind tree said nothing at all.",
    "charStart": 391,
    "charEnd": 447
  },
  {
    "index": 9,
    "startSeconds": 34.74,
    "endSeconds": 40.22,
    "text": "And Musa — in the neighbouring village — grew more and more uncomfortable.",
    "charStart": 449,
    "charEnd": 523
  },
  {
    "index": 10,
    "startSeconds": 40.22,
    "endSeconds": 42.65,
    "text": "He had expected a confrontation.",
    "charStart": 524,
    "charEnd": 556
  },
  {
    "index": 11,
    "startSeconds": 42.65,
    "endSeconds": 44.62,
    "text": "He had expected rage.",
    "charStart": 557,
    "charEnd": 578
  },
  {
    "index": 12,
    "startSeconds": 44.62,
    "endSeconds": 55.55,
    "text": "He had expected Demba to arrive at his compound with hard words and a crowd, so that Musa could stand his ground in front of witnesses and make the whole thing messy.",
    "charStart": 579,
    "charEnd": 745
  },
  {
    "index": 13,
    "startSeconds": 55.55,
    "endSeconds": 60.24,
    "text": "But there was no confrontation.",
    "charStart": 747,
    "charEnd": 778
  },
  {
    "index": 14,
    "startSeconds": 60.24,
    "endSeconds": 61.79,
    "text": "No rage.",
    "charStart": 779,
    "charEnd": 787
  },
  {
    "index": 15,
    "startSeconds": 61.79,
    "endSeconds": 64.2,
    "text": "No crowd.",
    "charStart": 788,
    "charEnd": 797
  },
  {
    "index": 16,
    "startSeconds": 64.2,
    "endSeconds": 66.25,
    "text": "Just Demba, calmly tending his forty cattle.",
    "charStart": 799,
    "charEnd": 843
  },
  {
    "index": 17,
    "startSeconds": 66.25,
    "endSeconds": 72.9,
    "text": "And that — that stillness, that patience, that refusal to be provoked — was more frightening than any anger could have been.",
    "charStart": 845,
    "charEnd": 969
  }
]