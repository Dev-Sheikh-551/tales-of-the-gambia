[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.22,
    "text": "Munyal.",
    "charStart": 0,
    "charEnd": 7
  },
  {
    "index": 1,
    "startSeconds": 2.22,
    "endSeconds": 3.68,
    "text": "Patience.",
    "charStart": 8,
    "charEnd": 17
  },
  {
    "index": 2,
    "startSeconds": 3.68,
    "endSeconds": 6.16,
    "text": "It is the first and highest value of Pulaaku.",
    "charStart": 19,
    "charEnd": 64
  },
  {
    "index": 3,
    "startSeconds": 6.16,
    "endSeconds": 14.27,
    "text": "Not courage in the sense of rushing forward — but courage in the sense of holding still when everything in you wants to move.",
    "charStart": 65,
    "charEnd": 190
  },
  {
    "index": 4,
    "startSeconds": 14.27,
    "endSeconds": 19.51,
    "text": "Of maintaining your dignity when the world gives you every reason to lose it.",
    "charStart": 191,
    "charEnd": 268
  },
  {
    "index": 5,
    "startSeconds": 19.51,
    "endSeconds": 25.74,
    "text": "The Fula have a saying: Munyal ko dow fuu.",
    "charStart": 270,
    "charEnd": 312
  },
  {
    "index": 6,
    "startSeconds": 25.74,
    "endSeconds": 28.3,
    "text": "Patience is above everything.",
    "charStart": 313,
    "charEnd": 342
  },
  {
    "index": 7,
    "startSeconds": 28.3,
    "endSeconds": 35.96,
    "text": "This is not a passive idea.",
    "charStart": 344,
    "charEnd": 371
  },
  {
    "index": 8,
    "startSeconds": 35.96,
    "endSeconds": 37.9,
    "text": "A Fula herdsman who rises before dawn every morning for forty years understands that patience is a form of work.",
    "charStart": 372,
    "charEnd": 484
  },
  {
    "index": 9,
    "startSeconds": 37.9,
    "endSeconds": 39.55,
    "text": "The most demanding form.",
    "charStart": 485,
    "charEnd": 509
  },
  {
    "index": 10,
    "startSeconds": 39.55,
    "endSeconds": 41.24,
    "text": "Anyone can shout.",
    "charStart": 510,
    "charEnd": 527
  },
  {
    "index": 11,
    "startSeconds": 41.24,
    "endSeconds": 44.54,
    "text": "Anyone can attack.",
    "charStart": 528,
    "charEnd": 546
  },
  {
    "index": 12,
    "startSeconds": 44.54,
    "endSeconds": 56.08,
    "text": "But to absorb an injury, to endure, to wait — and to do all of this without bitterness, without losing your sense of who you are — this requires something deeper than ordinary courage.",
    "charStart": 547,
    "charEnd": 731
  },
  {
    "index": 13,
    "startSeconds": 56.08,
    "endSeconds": 59.96,
    "text": "Demba understood this.",
    "charStart": 733,
    "charEnd": 755
  },
  {
    "index": 14,
    "startSeconds": 59.96,
    "endSeconds": 66.35,
    "text": "He tended his forty-three cattle — back to forty-three now — as the sun went down over the Gambia River.",
    "charStart": 757,
    "charEnd": 861
  },
  {
    "index": 15,
    "startSeconds": 66.35,
    "endSeconds": 68.51,
    "text": "The sky was the colour of mango skin.",
    "charStart": 862,
    "charEnd": 899
  },
  {
    "index": 16,
    "startSeconds": 68.51,
    "endSeconds": 71.23,
    "text": "The animals were calm.",
    "charStart": 900,
    "charEnd": 922
  },
  {
    "index": 17,
    "startSeconds": 71.23,
    "endSeconds": 73.49,
    "text": "He counted them one by one.",
    "charStart": 924,
    "charEnd": 951
  },
  {
    "index": 18,
    "startSeconds": 73.49,
    "endSeconds": 76.05,
    "text": "Each one had a name.",
    "charStart": 953,
    "charEnd": 973
  },
  {
    "index": 19,
    "startSeconds": 76.05,
    "endSeconds": 77.81,
    "text": "He said each name aloud.",
    "charStart": 975,
    "charEnd": 999
  },
  {
    "index": 20,
    "startSeconds": 77.81,
    "endSeconds": 79.45,
    "text": "And everything was as it should be.",
    "charStart": 1001,
    "charEnd": 1036
  }
]