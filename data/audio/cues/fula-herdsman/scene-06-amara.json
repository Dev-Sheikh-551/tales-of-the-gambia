[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.05,
    "text": "Munyal.",
    "charStart": 0,
    "charEnd": 7
  },
  {
    "index": 1,
    "startSeconds": 2.05,
    "endSeconds": 3.38,
    "text": "Patience.",
    "charStart": 8,
    "charEnd": 17
  },
  {
    "index": 2,
    "startSeconds": 3.38,
    "endSeconds": 5.65,
    "text": "It is the first and highest value of Pulaaku.",
    "charStart": 19,
    "charEnd": 64
  },
  {
    "index": 3,
    "startSeconds": 5.65,
    "endSeconds": 12.77,
    "text": "Not courage in the sense of rushing forward — but courage in the sense of holding still when everything in you wants to move.",
    "charStart": 65,
    "charEnd": 190
  },
  {
    "index": 4,
    "startSeconds": 12.77,
    "endSeconds": 17.3,
    "text": "Of maintaining your dignity when the world gives you every reason to lose it.",
    "charStart": 191,
    "charEnd": 268
  },
  {
    "index": 5,
    "startSeconds": 17.3,
    "endSeconds": 22.61,
    "text": "The Fula have a saying: Munyal ko dow fuu.",
    "charStart": 270,
    "charEnd": 312
  },
  {
    "index": 6,
    "startSeconds": 22.61,
    "endSeconds": 24.84,
    "text": "Patience is above everything.",
    "charStart": 313,
    "charEnd": 342
  },
  {
    "index": 7,
    "startSeconds": 24.84,
    "endSeconds": 31.78,
    "text": "This is not a passive idea.",
    "charStart": 344,
    "charEnd": 371
  },
  {
    "index": 8,
    "startSeconds": 31.78,
    "endSeconds": 33.66,
    "text": "A Fula herdsman who rises before dawn every morning for forty years understands that patience is a form of work.",
    "charStart": 372,
    "charEnd": 484
  },
  {
    "index": 9,
    "startSeconds": 33.66,
    "endSeconds": 35.25,
    "text": "The most demanding form.",
    "charStart": 485,
    "charEnd": 509
  },
  {
    "index": 10,
    "startSeconds": 35.25,
    "endSeconds": 36.83,
    "text": "Anyone can shout.",
    "charStart": 510,
    "charEnd": 527
  },
  {
    "index": 11,
    "startSeconds": 36.83,
    "endSeconds": 38.42,
    "text": "Anyone can attack.",
    "charStart": 528,
    "charEnd": 546
  },
  {
    "index": 12,
    "startSeconds": 38.42,
    "endSeconds": 49.86,
    "text": "But to absorb an injury, to endure, to wait — and to do all of this without bitterness, without losing your sense of who you are — this requires something deeper than ordinary courage.",
    "charStart": 547,
    "charEnd": 731
  },
  {
    "index": 13,
    "startSeconds": 49.86,
    "endSeconds": 51.97,
    "text": "Demba understood this.",
    "charStart": 733,
    "charEnd": 755
  },
  {
    "index": 14,
    "startSeconds": 51.97,
    "endSeconds": 59.34,
    "text": "He tended his forty-three cattle — back to forty-three now — as the sun went down over the Gambia River.",
    "charStart": 757,
    "charEnd": 861
  },
  {
    "index": 15,
    "startSeconds": 59.34,
    "endSeconds": 61.16,
    "text": "The sky was the colour of mango skin.",
    "charStart": 862,
    "charEnd": 899
  },
  {
    "index": 16,
    "startSeconds": 61.16,
    "endSeconds": 63.49,
    "text": "The animals were calm.",
    "charStart": 900,
    "charEnd": 922
  },
  {
    "index": 17,
    "startSeconds": 63.49,
    "endSeconds": 65.37,
    "text": "He counted them one by one.",
    "charStart": 924,
    "charEnd": 951
  },
  {
    "index": 18,
    "startSeconds": 65.37,
    "endSeconds": 67.46,
    "text": "Each one had a name.",
    "charStart": 953,
    "charEnd": 973
  },
  {
    "index": 19,
    "startSeconds": 67.46,
    "endSeconds": 68.98,
    "text": "He said each name aloud.",
    "charStart": 975,
    "charEnd": 999
  },
  {
    "index": 20,
    "startSeconds": 68.98,
    "endSeconds": 70.25,
    "text": "And everything was as it should be.",
    "charStart": 1001,
    "charEnd": 1036
  }
]