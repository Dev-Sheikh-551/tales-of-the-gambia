[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 4.92,
    "text": "Three weeks after the theft, Musa sent a young man to Demba's compound.",
    "charStart": 0,
    "charEnd": 71
  },
  {
    "index": 1,
    "startSeconds": 4.92,
    "endSeconds": 7.41,
    "text": "The young man carried an apology.",
    "charStart": 73,
    "charEnd": 106
  },
  {
    "index": 2,
    "startSeconds": 7.41,
    "endSeconds": 10.46,
    "text": "He carried a promise to return the three animals.",
    "charStart": 107,
    "charEnd": 156
  },
  {
    "index": 3,
    "startSeconds": 10.46,
    "endSeconds": 15.04,
    "text": "He also carried two additional goats, offered as the payment of shame.",
    "charStart": 157,
    "charEnd": 227
  },
  {
    "index": 4,
    "startSeconds": 15.04,
    "endSeconds": 17.89,
    "text": "Demba received the young man courteously.",
    "charStart": 229,
    "charEnd": 270
  },
  {
    "index": 5,
    "startSeconds": 17.89,
    "endSeconds": 21.49,
    "text": "He offered him water and food, as one does with any guest.",
    "charStart": 271,
    "charEnd": 329
  },
  {
    "index": 6,
    "startSeconds": 21.49,
    "endSeconds": 23.1,
    "text": "He said only this:",
    "charStart": 330,
    "charEnd": 348
  },
  {
    "index": 7,
    "startSeconds": 23.1,
    "endSeconds": 26.33,
    "text": "\"Tell Musa that I hold no anger toward him.",
    "charStart": 350,
    "charEnd": 393
  },
  {
    "index": 8,
    "startSeconds": 26.33,
    "endSeconds": 30.77,
    "text": "Tell him that the cattle may come home whenever he is ready to bring them.\"",
    "charStart": 394,
    "charEnd": 469
  },
  {
    "index": 9,
    "startSeconds": 30.77,
    "endSeconds": 34.24,
    "text": "The three cattle were returned the following morning.",
    "charStart": 471,
    "charEnd": 524
  },
  {
    "index": 10,
    "startSeconds": 34.24,
    "endSeconds": 41.17,
    "text": "When Demba brought the news to the old man under the tamarind tree, the elder smiled for the first time in weeks.",
    "charStart": 526,
    "charEnd": 639
  },
  {
    "index": 11,
    "startSeconds": 41.17,
    "endSeconds": 42.27,
    "text": "\"You see?\"",
    "charStart": 641,
    "charEnd": 651
  },
  {
    "index": 12,
    "startSeconds": 42.27,
    "endSeconds": 43.51,
    "text": "the old man said.",
    "charStart": 652,
    "charEnd": 669
  },
  {
    "index": 13,
    "startSeconds": 43.51,
    "endSeconds": 45.98,
    "text": "\"Musa expected a battle he could fight.",
    "charStart": 670,
    "charEnd": 709
  },
  {
    "index": 14,
    "startSeconds": 45.98,
    "endSeconds": 48.79,
    "text": "You gave him a silence he could not survive.\"",
    "charStart": 710,
    "charEnd": 755
  },
  {
    "index": 15,
    "startSeconds": 48.79,
    "endSeconds": 53.25,
    "text": "Demba sat beside him and watched the village go about its business.",
    "charStart": 757,
    "charEnd": 824
  },
  {
    "index": 16,
    "startSeconds": 53.25,
    "endSeconds": 56.92,
    "text": "\"It was the hardest thing I have ever done,\" Demba said.",
    "charStart": 826,
    "charEnd": 882
  },
  {
    "index": 17,
    "startSeconds": 56.92,
    "endSeconds": 59.12,
    "text": "\"Yes,\" the old man agreed.",
    "charStart": 884,
    "charEnd": 910
  },
  {
    "index": 18,
    "startSeconds": 59.12,
    "endSeconds": 61.9,
    "text": "\"That is why Pulaaku is worth keeping.\"",
    "charStart": 911,
    "charEnd": 950
  }
]