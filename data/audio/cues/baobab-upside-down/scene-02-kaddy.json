[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 2.68,
    "text": "The baobab began to complain.",
    "charStart": 0,
    "charEnd": 29
  },
  {
    "index": 1,
    "startSeconds": 2.68,
    "endSeconds": 4.6,
    "text": "Why am I planted here?",
    "charStart": 31,
    "charEnd": 53
  },
  {
    "index": 2,
    "startSeconds": 4.6,
    "endSeconds": 5.52,
    "text": "it said.",
    "charStart": 54,
    "charEnd": 62
  },
  {
    "index": 3,
    "startSeconds": 5.52,
    "endSeconds": 7.52,
    "text": "This ground is too dry.",
    "charStart": 63,
    "charEnd": 86
  },
  {
    "index": 4,
    "startSeconds": 7.52,
    "endSeconds": 11.31,
    "text": "I should be by the river, where my roots can drink properly.",
    "charStart": 87,
    "charEnd": 147
  },
  {
    "index": 5,
    "startSeconds": 11.31,
    "endSeconds": 13.59,
    "text": "The Creator said nothing.",
    "charStart": 149,
    "charEnd": 174
  },
  {
    "index": 6,
    "startSeconds": 13.59,
    "endSeconds": 18.35,
    "text": "Why do the other trees grow so tall when I am so much more beautiful?",
    "charStart": 176,
    "charEnd": 245
  },
  {
    "index": 7,
    "startSeconds": 18.35,
    "endSeconds": 20.37,
    "text": "the baobab continued.",
    "charStart": 246,
    "charEnd": 267
  },
  {
    "index": 8,
    "startSeconds": 20.37,
    "endSeconds": 22.23,
    "text": "The palm is ugly.",
    "charStart": 268,
    "charEnd": 285
  },
  {
    "index": 9,
    "startSeconds": 22.23,
    "endSeconds": 24.9,
    "text": "The acacia is barely worth looking at.",
    "charStart": 286,
    "charEnd": 324
  },
  {
    "index": 10,
    "startSeconds": 24.9,
    "endSeconds": 29.56,
    "text": "I should be at the centre of everything — where everyone can see me properly.",
    "charStart": 325,
    "charEnd": 402
  },
  {
    "index": 11,
    "startSeconds": 29.56,
    "endSeconds": 32.04,
    "text": "The Creator remained patient.",
    "charStart": 404,
    "charEnd": 433
  },
  {
    "index": 12,
    "startSeconds": 32.04,
    "endSeconds": 35.24,
    "text": "And these fruits, the baobab went on.",
    "charStart": 435,
    "charEnd": 472
  },
  {
    "index": 13,
    "startSeconds": 35.24,
    "endSeconds": 42.27,
    "text": "I produce such extraordinary fruit and the animals just eat it and go away without so much as appreciating it.",
    "charStart": 473,
    "charEnd": 583
  },
  {
    "index": 14,
    "startSeconds": 42.27,
    "endSeconds": 45.45,
    "text": "They eat the mango as if it is equal to mine.",
    "charStart": 584,
    "charEnd": 629
  },
  {
    "index": 15,
    "startSeconds": 45.45,
    "endSeconds": 46.91,
    "text": "It is not equal.",
    "charStart": 630,
    "charEnd": 646
  },
  {
    "index": 16,
    "startSeconds": 46.91,
    "endSeconds": 49.21,
    "text": "Nothing is equal to mine.",
    "charStart": 647,
    "charEnd": 672
  },
  {
    "index": 17,
    "startSeconds": 49.21,
    "endSeconds": 59.64,
    "text": "The Creator, who had made everything from the silence of the world and knew the particular vanity of beautiful things, listened to this for a long time.",
    "charStart": 674,
    "charEnd": 826
  },
  {
    "index": 18,
    "startSeconds": 59.64,
    "endSeconds": 66.0,
    "text": "And then decided the baobab had been beautiful for long enough in its current configuration.",
    "charStart": 828,
    "charEnd": 920
  }
]