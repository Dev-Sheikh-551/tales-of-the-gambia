[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 3.29,
    "text": "The baobab stood upside down, and sulked.",
    "charStart": 0,
    "charEnd": 41
  },
  {
    "index": 1,
    "startSeconds": 3.29,
    "endSeconds": 8.01,
    "text": "For a season — perhaps more — it refused to do anything.",
    "charStart": 43,
    "charEnd": 99
  },
  {
    "index": 2,
    "startSeconds": 8.01,
    "endSeconds": 13.12,
    "text": "What was the point of producing fruit if no one could see how beautiful you were?",
    "charStart": 100,
    "charEnd": 181
  },
  {
    "index": 3,
    "startSeconds": 13.12,
    "endSeconds": 17.92,
    "text": "What was the point of flowering if your flowers bloomed underground?",
    "charStart": 182,
    "charEnd": 250
  },
  {
    "index": 4,
    "startSeconds": 17.92,
    "endSeconds": 20.67,
    "text": "But time is a patient teacher.",
    "charStart": 252,
    "charEnd": 282
  },
  {
    "index": 5,
    "startSeconds": 20.67,
    "endSeconds": 28.2,
    "text": "Slowly, the baobab began to understand something it had never noticed before: it was not alone.",
    "charStart": 284,
    "charEnd": 379
  },
  {
    "index": 6,
    "startSeconds": 28.2,
    "endSeconds": 36.87,
    "text": "Birds came to nest in its strange upside-down branches — the roots now held above the earth like a palace of tangled wood.",
    "charStart": 381,
    "charEnd": 503
  },
  {
    "index": 7,
    "startSeconds": 36.87,
    "endSeconds": 43.14,
    "text": "Animals sheltered in the deep crevices of its enormous trunk, out of the rain and the heat.",
    "charStart": 504,
    "charEnd": 595
  },
  {
    "index": 8,
    "startSeconds": 43.14,
    "endSeconds": 52.11,
    "text": "People came to collect its fruit (which still tasted excellent, even upside down).",
    "charStart": 596,
    "charEnd": 678
  },
  {
    "index": 9,
    "startSeconds": 52.11,
    "endSeconds": 53.72,
    "text": "Healers found medicine in its bark.",
    "charStart": 679,
    "charEnd": 714
  },
  {
    "index": 10,
    "startSeconds": 53.72,
    "endSeconds": 57.53,
    "text": "The baobab, in its absurd new form, had become a gathering place.",
    "charStart": 716,
    "charEnd": 781
  },
  {
    "index": 11,
    "startSeconds": 57.53,
    "endSeconds": 59.31,
    "text": "Children climbed it.",
    "charStart": 783,
    "charEnd": 803
  },
  {
    "index": 12,
    "startSeconds": 59.31,
    "endSeconds": 61.44,
    "text": "Elders held meetings beneath it.",
    "charStart": 804,
    "charEnd": 836
  },
  {
    "index": 13,
    "startSeconds": 61.44,
    "endSeconds": 63.89,
    "text": "Travellers rested in its shade.",
    "charStart": 837,
    "charEnd": 868
  },
  {
    "index": 14,
    "startSeconds": 63.89,
    "endSeconds": 70.76,
    "text": "The village of animals and people reorganised itself around the strange, proud, humbled tree.",
    "charStart": 869,
    "charEnd": 962
  },
  {
    "index": 15,
    "startSeconds": 70.76,
    "endSeconds": 77.8,
    "text": "And the baobab, for the first time, felt something it had never felt when it was merely beautiful.",
    "charStart": 964,
    "charEnd": 1062
  },
  {
    "index": 16,
    "startSeconds": 77.8,
    "endSeconds": 80.25,
    "text": "It felt necessary.",
    "charStart": 1064,
    "charEnd": 1082
  }
]