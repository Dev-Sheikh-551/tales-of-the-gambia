[
  {
    "index": 0,
    "startSeconds": 0.0,
    "endSeconds": 3.0,
    "text": "The baobab began to complain.",
    "charStart": 0,
    "charEnd": 29
  },
  {
    "index": 1,
    "startSeconds": 3.0,
    "endSeconds": 5.64,
    "text": "Why am I planted here?",
    "charStart": 31,
    "charEnd": 53
  },
  {
    "index": 2,
    "startSeconds": 5.64,
    "endSeconds": 7.62,
    "text": "it said.",
    "charStart": 54,
    "charEnd": 62
  },
  {
    "index": 3,
    "startSeconds": 7.62,
    "endSeconds": 11.52,
    "text": "This ground is too dry.",
    "charStart": 63,
    "charEnd": 86
  },
  {
    "index": 4,
    "startSeconds": 11.52,
    "endSeconds": 14.02,
    "text": "I should be by the river, where my roots can drink properly.",
    "charStart": 87,
    "charEnd": 147
  },
  {
    "index": 5,
    "startSeconds": 14.02,
    "endSeconds": 18.92,
    "text": "The Creator said nothing.",
    "charStart": 149,
    "charEnd": 174
  },
  {
    "index": 6,
    "startSeconds": 18.92,
    "endSeconds": 20.97,
    "text": "Why do the other trees grow so tall when I am so much more beautiful?",
    "charStart": 176,
    "charEnd": 245
  },
  {
    "index": 7,
    "startSeconds": 20.97,
    "endSeconds": 22.84,
    "text": "the baobab continued.",
    "charStart": 246,
    "charEnd": 267
  },
  {
    "index": 8,
    "startSeconds": 22.84,
    "endSeconds": 25.6,
    "text": "The palm is ugly.",
    "charStart": 268,
    "charEnd": 285
  },
  {
    "index": 9,
    "startSeconds": 25.6,
    "endSeconds": 30.47,
    "text": "The acacia is barely worth looking at.",
    "charStart": 286,
    "charEnd": 324
  },
  {
    "index": 10,
    "startSeconds": 30.47,
    "endSeconds": 33.2,
    "text": "I should be at the centre of everything — where everyone can see me properly.",
    "charStart": 325,
    "charEnd": 402
  },
  {
    "index": 11,
    "startSeconds": 33.2,
    "endSeconds": 36.38,
    "text": "The Creator remained patient.",
    "charStart": 404,
    "charEnd": 433
  },
  {
    "index": 12,
    "startSeconds": 36.38,
    "endSeconds": 39.1,
    "text": "And these fruits, the baobab went on.",
    "charStart": 435,
    "charEnd": 472
  },
  {
    "index": 13,
    "startSeconds": 39.1,
    "endSeconds": 43.82,
    "text": "I produce such extraordinary fruit and the animals just eat it and go away without so much as appreciating it.",
    "charStart": 473,
    "charEnd": 583
  },
  {
    "index": 14,
    "startSeconds": 43.82,
    "endSeconds": 47.12,
    "text": "They eat the mango as if it is equal to mine.",
    "charStart": 584,
    "charEnd": 629
  },
  {
    "index": 15,
    "startSeconds": 47.12,
    "endSeconds": 48.64,
    "text": "It is not equal.",
    "charStart": 630,
    "charEnd": 646
  },
  {
    "index": 16,
    "startSeconds": 48.64,
    "endSeconds": 50.97,
    "text": "Nothing is equal to mine.",
    "charStart": 647,
    "charEnd": 672
  },
  {
    "index": 17,
    "startSeconds": 50.97,
    "endSeconds": 61.9,
    "text": "The Creator, who had made everything from the silence of the world and knew the particular vanity of beautiful things, listened to this for a long time.",
    "charStart": 674,
    "charEnd": 826
  },
  {
    "index": 18,
    "startSeconds": 61.9,
    "endSeconds": 68.8,
    "text": "And then decided the baobab had been beautiful for long enough in its current configuration.",
    "charStart": 828,
    "charEnd": 920
  }
]